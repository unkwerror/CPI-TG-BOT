# BEGIN CPI ARTIFACTS
# Services are discovered through the isolated cpi-artifacts-caddy network.
__ARTIFACTS_DOMAIN__ {
	encode zstd gzip

	handle /api/* {
		reverse_proxy artifacts-api:3001
	}

	handle /documentation* {
		reverse_proxy artifacts-api:3001
	}

	handle /health/api/* {
		uri replace /health/api /health
		reverse_proxy artifacts-api:3001
	}

	handle /telegram/webhook {
		reverse_proxy artifacts-bot:3002
	}

	handle {
		reverse_proxy artifacts-web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

__ARTIFACTS_S3_DOMAIN__ {
	reverse_proxy artifacts-minio:9000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
# END CPI ARTIFACTS
