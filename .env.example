# Public URLs
WEB_ORIGIN=http://localhost:8080
S3_PUBLIC_ENDPOINT=http://localhost:9000
ARTIFACTS_DOMAIN=artifacts.62-113-105-225.sslip.io
ARTIFACTS_S3_DOMAIN=uploads-artifacts.62-113-105-225.sslip.io

# PostgreSQL owner and restricted runtime role
POSTGRES_DB=artifacts
POSTGRES_USER=artifacts_owner
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_OWNER_PASSWORD
APP_DB_USER=artifacts_app
APP_DB_PASSWORD=CHANGE_ME_LONG_DATABASE_APP_PASSWORD
DATABASE_URL=postgresql://artifacts_app:CHANGE_ME_LONG_DATABASE_APP_PASSWORD@postgres:5432/artifacts
MIGRATION_DATABASE_URL=postgresql://artifacts_owner:CHANGE_ME_LONG_DATABASE_OWNER_PASSWORD@postgres:5432/artifacts

# Redis
REDIS_PASSWORD=CHANGE_ME_LONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LONG_REDIS_PASSWORD@redis:6379
REDIS_PREFIX=cpi-artifacts

# Private MinIO/S3
MINIO_ROOT_USER=artifacts_root
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD_AT_LEAST_16_CHARS
S3_ACCESS_KEY=artifacts_app
S3_SECRET_KEY=CHANGE_ME_S3_APPLICATION_SECRET_AT_LEAST_16_CHARS
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_QUARANTINE_BUCKET=artifacts-quarantine
S3_PRIVATE_BUCKET=artifacts-private
S3_EXPORT_BUCKET=artifacts-exports
S3_FORCE_PATH_STYLE=true

# Telegram. Create a bot via @BotFather; never commit the real token.
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOTFATHER_TOKEN
SUPERADMIN_TELEGRAM_IDS=123456789
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
BOT_MODE=polling
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET_AT_LEAST_16_CHARS
WEB_APP_URL=http://localhost:8080

# CRM integration. Use the same token in the CRM configuration.
CRM_API_URL=http://localhost:3000/api
# URL seen from the local Docker worker; override if CRM runs elsewhere.
CRM_DOCKER_API_URL=http://host.docker.internal:3000/api
CRM_INTEGRATION_TOKEN=local-locker-integration-token-change-me

# Sessions, upload and worker policy
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=cpi_artifacts_session
COOKIE_DOMAIN=
PRESIGNED_URL_TTL_SECONDS=900
MULTIPART_THRESHOLD_BYTES=20971520
MULTIPART_PART_SIZE_BYTES=10485760
GLOBAL_MAX_FILE_SIZE_BYTES=2147483648
FILE_VERIFICATION_MODE=metadata-only
CLAMAV_HOST=
CLAMAV_PORT=3310
EXPORT_RETENTION_HOURS=1
ABANDONED_UPLOAD_HOURS=1
DELETED_OBJECT_RETENTION_DAYS=0
WORKER_CONCURRENCY=2

# Runtime
NODE_ENV=development
DEV_AUTH_ENABLED=true
NEXT_PUBLIC_DEV_AUTH_ENABLED=true
LOG_LEVEL=info
SEED_ADMIN_TELEGRAM_ID=999000111
